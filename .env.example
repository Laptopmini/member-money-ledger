# Copy to .env (git-ignored) to override defaults. Compose reads .env for ${VAR} interpolation,
# and api/sync_worker also load it through env_file. Every value below has a default in
# docker-compose.yml, so an empty .env is valid.

# Django
DJANGO_SECRET_KEY=dev-only-placeholder-not-a-secret   # required outside dev; generate a real one for prod
DJANGO_DEBUG=1                                       # 1 in dev, 0 in prod (api_prod forces 0)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api         # comma-separated

# Vendor (Ledgerly) and the web dev proxy target
VENDOR_URL=http://vendor:8080
API_URL=http://api:8000                              # Vite dev proxy target for /api

# Postgres (defaults match the db service)
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Feature flags (flagd)
FLAGD_HOST=flagd
FLAGD_PORT=8013

# Optional LLM for category suggestions (leave empty to disable)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Auth: the one seeded member (member@example.com). Dev (DEBUG=1) defaults to
# demo-password-2026; the prod profile uses this value too (demo only).
DEMO_MEMBER_PASSWORD=demo-password-2026
TRUST_PROXY=0                                        # 1 only behind a proxy you control (Caddy in prod)
